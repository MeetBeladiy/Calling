NODE_ENV=development
HOST=0.0.0.0
PORT=8080
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=calling-app
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
DATA_FILE=./data/calling-app.json
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# Comma-separated STUN URLs. Public STUN is suitable for development only.
STUN_URLS=stun:stun.l.google.com:19302
# Configure a production TURN service (for example coturn).
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Optional: Android push delivery should be implemented by an FCM adapter.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
